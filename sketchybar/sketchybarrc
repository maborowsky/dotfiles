##### Adding Left Items #####
# We add some regular items to the left side of the bar, where
# only the properties deviating from the current defaults need to be set

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_mode_change

# Aerospace binding mode indicator (hidden in 'main', visible in 'service')
sketchybar --add item aerospace_mode left \
           --subscribe aerospace_mode aerospace_mode_change \
           --set aerospace_mode \
               drawing=off \
               icon= \
               icon.padding_left=6 \
               icon.padding_right=4 \
               label.padding_right=8 \
               background.color=0x33ff5555 \
               background.corner_radius=5 \
               background.height=20 \
               script="$PLUGIN_DIR/aerospace_mode.sh"

# Aerospace layout of the focused window's parent container
sketchybar --add item aerospace_layout left \
           --subscribe aerospace_layout aerospace_workspace_change aerospace_mode_change \
           --set aerospace_layout \
               update_freq=2 \
               icon.drawing=off \
               label.padding_left=4 \
               label.padding_right=4 \
               background.color=0x33ffffff \
               background.corner_radius=5 \
               background.height=20 \
               script="$PLUGIN_DIR/aerospace_layout.sh"

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        icon.drawing=off \
        background.color=0x44ffffff \
        background.corner_radius=5 \
        background.height=20 \
        background.drawing=off \
        drawing=off \
        label="$sid" \
        label.padding_left=8 \
        label.padding_right=8 \
        click_script="aerospace workspace $sid" \
        script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

